# ADK Book Management System - Environment Variables & Account Connector Credentials

# 1. Gemini / GCP Enterprise Credentials
GEMINI_API_KEY="your-gemini-api-key-here"
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="us-central1"

# 2. Goodreads Account Credentials
# Get your User ID from your Goodreads Profile URL: https://www.goodreads.com/user/show/XXXXX-name
GOODREADS_USER_ID="12345678"
GOODREADS_API_KEY="your-goodreads-developer-key"
GOODREADS_TBR_RSS_URL="https://www.goodreads.com/review/list_rss/12345678?shelf=to-read"

# 3. Libby / OverDrive Library Credentials
# Add your library card details or OverDrive OAuth setup
LIBBY_CARD_NUMBER="21234567890123"
LIBBY_LIBRARY_SYSTEM="New York Public Library" # e.g. "Seattle Public Library", "Chicago Public Library"
OVERDRIVE_CLIENT_ID="your-overdrive-client-id"
OVERDRIVE_CLIENT_SECRET="your-overdrive-client-secret"

# 4. Amazon Kindle Deals & Whispersync Integration
AMAZON_KINDLE_EMAIL="your-kindle-email@kindle.com"
AMAZON_1CLICK_APPROVAL_THRESHOLD_USD="4.99"
AMAZON_PAAPI_KEY="your-amazon-associate-api-key" # Optional for live deal lookup

# 5. ADK Activity Logging & Telemetry
ADK_TRACE_LEVEL="VERBOSE"
ADK_APP_DATA_DIR="~/.gemini/antigravity-cli/book_management"
